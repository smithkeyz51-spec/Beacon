rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can read/write their own devices. Updates to lastSeen/
    // lastLocation also come from the anonymous tracked-device page (via
    // a share link), so we allow a narrow anonymous update too — only
    // those two fields, only on an already-existing device.
    match /users/{userId}/devices/{deviceId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, delete: if request.auth != null && request.auth.uid == userId;
      allow update: if (request.auth != null && request.auth.uid == userId)
        || isValidLocationUpdate();

      match /pings/{pingId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        // Writes to pings also happen via share links (unauthenticated
        // tracked-device page). We allow create-only, and only fields we
        // expect, so an anonymous writer can't do anything else.
        allow create: if isValidPing();
        allow update, delete: if false;
      }
    }

    // Share link tokens map to (uid, deviceId). Anyone with the exact
    // token can resolve it (that's the point — it's a bearer link), but
    // no one can list all tokens or guess one, since Firestore doesn't
    // allow arbitrary queries without an index and document IDs are
    // random 24-char tokens.
    match /shareLinks/{token} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    function isValidLocationUpdate() {
      let d = request.resource.data;
      return d.diff(resource.data).affectedKeys().hasOnly(['lastSeen', 'lastLocation'])
        && d.lastLocation.lat is number && d.lastLocation.lat >= -90 && d.lastLocation.lat <= 90
        && d.lastLocation.lng is number && d.lastLocation.lng >= -180 && d.lastLocation.lng <= 180;
    }

    function isValidPing() {
      let d = request.resource.data;
      return d.keys().hasOnly(['lat', 'lng', 'accuracy', 'at'])
        && d.lat is number && d.lat >= -90 && d.lat <= 90
        && d.lng is number && d.lng >= -180 && d.lng <= 180;
    }
  }
}
