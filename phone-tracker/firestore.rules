rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId}/devices/{deviceId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, delete: if request.auth != null && request.auth.uid == userId;
      allow update: if (request.auth != null && request.auth.uid == userId)
        || isValidLocationUpdate();

      match /pings/{pingId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if isValidPing();
        allow update, delete: if false;
      }
    }

    match /shareLinks/{token} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    function isValidLocationUpdate() {
      let d = request.resource.data;
      return d.diff(resource.data).affectedKeys().hasOnly(['lastSeen', 'lastLocation'])
        && d.lastLocation.lat is number && d.lastLocation.lat >= -90 && d.lastLocation.lat <= 90
        && d.lastLocation.lng is number && d.lastLocation.lng >= -180 && d.lastLocation.lng <= 180;
    }

    function isValidPing() {
      let d = request.resource.data;
      return d.keys().hasOnly(['lat', 'lng', 'accuracy', 'at'])
        && d.lat is number && d.lat >= -90 && d.lat <= 90
        && d.lng is number && d.lng >= -180 && d.lng <= 180;
    }
  }
}
